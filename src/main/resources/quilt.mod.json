{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.stellar",
    "id": "stellar_rays",
    "version": "1.0.0",
    "metadata": {
      "name": "Stellar Rays",
      "description": "Client-side visual enhancement and ray rendering mod for Minecraft",
      "icon": "assets/stellar_rays/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "client": {
        "adapter": "kotlin",
        "value": "com.stellar.rays.StellarRaysMod"
      },
      "modmenu": {
        "adapter": "kotlin",
        "value": "com.stellar.rays.config.StellarRaysModMenu"
      }
    },
    "depends": [
      {
        "id": "modmenu",
        "versions": "*",
        "optional": true
      }
    ]
  },
  "mixin": "stellar_rays.mixins.json"
}
